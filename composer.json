{
    "name": "laravel-lang/publisher",
    "description": "Localization publisher for your Laravel application",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "i18n",
        "locales",
        "localization",
        "localizations",
        "translation",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "composer/semver": "^3.4",
        "illuminate/console": "^12.0 || ^13.0 || dev-master",
        "illuminate/container": "^12.0 || ^13.0 || dev-master",
        "illuminate/filesystem": "^12.0 || ^13.0 || dev-master",
        "illuminate/support": "^12.0 || ^13.0 || dev-master",
        "laravel-lang/config": "self.version",
        "laravel-lang/exceptions": "self.version",
        "laravel-lang/filesystem": "self.version",
        "laravel-lang/locale-list": "self.version",
        "laravel-lang/locales": "self.version",
        "laravel/prompts": ">=0.3.27",
        "league/commonmark": "^2.10.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Publisher\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Publisher\\LangPublisherServiceProvider"
            ]
        }
    }
}
